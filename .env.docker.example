# Copy to .env.docker for local Docker Compose. Do not use these values in production.
API_GATEWAY_HOST_PORT=18088

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me
USER_DB_NAME=identity_db
PRODUCT_DB_NAME=product_db
ORDER_DB_NAME=order_and_inventory_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db
USER_DB_HOST_PORT=5433
PRODUCT_DB_HOST_PORT=5434
ORDER_DB_HOST_PORT=5435
PAYMENT_DB_HOST_PORT=5436
NOTIFICATION_DB_HOST_PORT=5437

RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_AMQP_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673
NOTIFICATION_RABBITMQ_MAX_ATTEMPTS=5

JWT_SECRET=replace-with-a-long-random-secret-shared-by-all-services
ORDER_PAYMENT_EXPIRATION_MINUTES=15
OUTBOX_PUBLISH_DELAY_MS=1000
OUTBOX_CONFIRM_TIMEOUT_MS=5000

# Required by the automatic Stripe CLI Docker service.
STRIPE_SECRET_KEY=
# Only needed when running Payment Service without the Stripe CLI sidecar.
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:18088/api/payments/success
PAYMENT_CANCEL_URL=http://localhost:18088/api/payments/cancel

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
